# Public origin agents will see in OpenAPI, llms.txt, x402, and the agent card.
# Production: https://afterimage.page
AFTERIMAGE_PUBLIC_URL=http://localhost:8080

AFTERIMAGE_HOST=0.0.0.0
AFTERIMAGE_PORT=8080
AFTERIMAGE_SQLITE_PATH=data/afterimage.db

# Cache caps — AfterImage is not an archive.
AFTERIMAGE_MAX_SNAPSHOTS=5000
AFTERIMAGE_MAX_TEXT_CHARS=32000
AFTERIMAGE_SNAPSHOT_TTL_S=604800
AFTERIMAGE_PERSIST_ERROR_PAGES=false

# Base mainnet address that receives x402 USDC. Required for agent-paid calls
# and for listing in the x402 Bazaar. Leave empty to keep Stripe-only.
AFTERIMAGE_PAY_TO=
AFTERIMAGE_NETWORK=eip155:8453
AFTERIMAGE_USDC_ASSET=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913

# Public x402.org facilitator (no API key). CDP Bazaar indexing needs the
# CDP facilitator instead: https://api.cdp.coinbase.com/platform/v2/x402
AFTERIMAGE_FACILITATOR_URL=https://x402.org/facilitator

# Stripe credit packs (humans pay, agents use the API key).
AFTERIMAGE_STRIPE_SECRET_KEY=
AFTERIMAGE_STRIPE_WEBHOOK_SECRET=
